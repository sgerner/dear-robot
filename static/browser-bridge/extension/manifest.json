{
  "manifest_version": 3,
  "name": "Dear Robot Browser Bridge",
  "version": "0.4.0",
  "description": "Record a dashboard report workflow in the browser you are already using.",
  "permissions": ["tabs", "downloads", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Dear Robot Browser Bridge"
  }
}
