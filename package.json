    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "imapflow": "^1.3.3",
    "lucide-svelte": "^1.0.1",
    "mailparser": "^3.9.8",
